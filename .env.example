# Copy to .env.local and adjust only if your backends run elsewhere.
#
# MUST be `localhost`, never `127.0.0.1` — session cookies are host-scoped and
# the browser treats the two as different hosts, which breaks Sanctum auth
# silently. See CLAUDE.md.
VITE_API_BASE_URL=http://localhost:8000
VITE_ENGINE_WS_URL=ws://localhost:8080

# --- Display tunables (see src/lib/config.ts for rationale on each default) ---
# All optional. Same standard as the API's config/trading.php: change them here,
# never by hardcoding a different number at a call site.

# Whitespace slots drawn across a skipped-candle gap. The gap is meant to be
# visible, not to scale — a weekend is ~2,880 empty 1-minute buckets.
# VITE_MAX_GAP_SLOTS=10

# Closed candles retained client-side. Kept above the engine's own per-instrument
# historyLimit (default 100) so a reconnect's candle_history is never truncated.
# VITE_CANDLE_HISTORY_LIMIT=500

# VITE_TRADE_BUFFER_SIZE=50
# VITE_VISIBLE_TRADES=12
# VITE_DEPTH_LEVELS=8

# Decimal places for account money fields (the API returns integer cents).
# VITE_MONEY_SCALE=2

# How often the account view re-reads balance/equity/margin. These are computed
# live per request and never cached server-side, so "live" means polling.
# VITE_ACCOUNT_POLL_MS=5000
